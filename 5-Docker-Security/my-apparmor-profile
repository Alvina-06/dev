
#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
    #include <abstractions/base>
                  
    /usr/** mr,
    /lib/** mr,
    /lib64/** mr,
    /etc/Id.so.cache r,
    /etc/Id.so.conf r,
    /etc/Id.so.conf.d/** r,

    /app/** rwk,
    deny /var/** w,
    deny capability sys_admin,
}
